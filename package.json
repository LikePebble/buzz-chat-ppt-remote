{
  "name": "buzz-chat-ppt-remote",
  "version": "2.5.7",
  "description": "Local audience buzzer, chat and PowerPoint remote for Apple Silicon",
  "main": "./out/main/index.js",
  "author": "smilexizheng",
  "private": "true",
  "homepage": "https://github.com/LikePebble/buzz-chat-ppt-remote",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build && node scripts/source-archive.mjs",
    "build:mac:arm64": "npm run build && electron-builder --mac --arm64 --publish never",
    "lint": "eslint src/interaction src/renderer/interaction tests scripts electron.vite.config.ts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "tsx --test tests/*.test.ts",
    "test:load": "tsx scripts/buzz-load-test.ts",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "express": "5.1.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.19.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^39.2.7",
    "electron-builder": "^26.1.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "prettier": "^3.7.4",
    "qr-code-styling": "^1.9.2",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3",
    "vite": "npm:rolldown-vite@7.3.0",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.6",
    "tsx": "^4.20.0"
  },
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
